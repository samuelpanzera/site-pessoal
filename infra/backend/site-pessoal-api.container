[Unit]
Description=Site Pessoal API (Go/Fiber)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/samuelpanzera/site-pessoal-api:latest
ContainerName=site-pessoal-api
PublishPort=127.0.0.1:3101:3000
Environment=PORT=3000
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
