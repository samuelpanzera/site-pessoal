server {
    listen 80;
    server_name api.samuelpanzera.com.br;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.samuelpanzera.com.br;

    ssl_certificate     /root/.acme.sh/samuelpanzera.com.br_ecc/samuelpanzera.com.br.cer;
    ssl_certificate_key /root/.acme.sh/samuelpanzera.com.br_ecc/samuelpanzera.com.br.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff"          always;

    # CORS — permite apenas o frontend oficial
    add_header Access-Control-Allow-Origin  "https://samuelpanzera.com.br" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS"            always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type"   always;

    location / {
        # Responde preflight CORS sem bater no app
        if ($request_method = OPTIONS) {
            return 204;
        }

        proxy_pass         http://127.0.0.1:3000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
    }
}
